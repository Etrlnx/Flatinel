# Application Settings
PROJECT_NAME="Society Maintenance Tracker"
ENVIRONMENT="development"
SECRET_KEY="supersecretjwtkey_change_in_production_environment"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default SQLite for easy zero-setup local dev. For PostgreSQL: postgresql://user:password@localhost:5432/society_db
DATABASE_URL="sqlite:///./society_maintenance.db"

# Uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=5

# Default Overdue Threshold (Days)
DEFAULT_OVERDUE_DAYS=3

# CORS
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Email Configuration (Optional SMTP / Mock)
# If SMTP_HOST is empty, emails are logged to console (Mock Mode)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@societymaintenance.local"
SMTP_FROM_NAME="Society Maintenance Portal"
