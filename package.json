{
  "name": "flatinel-society-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack Society Maintenance Tracker",
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue.bold,cyan.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "python -m uvicorn backend.app.main:app --reload --port 8000",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "start": "python -m uvicorn backend.app.main:app --host 0.0.0.0 --port 8000",
    "test": "pytest"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
